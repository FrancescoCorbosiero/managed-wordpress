{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "cesana/blog-cover",
    "version": "1.0.0",
    "title": "Blog Cover",
    "category": "cesana",
    "icon": "format-image",
    "description": "Cover per articoli e pagine con eyebrow, titolo, estratto e metadati.",
    "keywords": ["cover", "copertina", "blog", "articolo", "header"],
    "textdomain": "cesana-assicuratori-blocks",
    "attributes": {
        "eyebrow": {
            "type": "string",
            "default": ""
        },
        "title": {
            "type": "string",
            "default": ""
        },
        "excerpt": {
            "type": "string",
            "default": ""
        },
        "authorName": {
            "type": "string",
            "default": ""
        },
        "date": {
            "type": "string",
            "default": ""
        },
        "readingTime": {
            "type": "string",
            "default": ""
        },
        "backgroundImage": {
            "type": "string",
            "default": ""
        },
        "overlayOpacity": {
            "type": "number",
            "default": 70
        },
        "textAlign": {
            "type": "string",
            "default": "left"
        }
    },
    "supports": {
        "align": ["full"],
        "html": false
    },
    "editorScript": "file:./editor.js",
    "render": "file:./render.php"
}
