{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "cesana/category-posts",
    "version": "1.0.0",
    "title": "Category Posts",
    "category": "cesana",
    "icon": "category",
    "description": "Griglia di articoli per categoria con card editoriali in stile Cesana.",
    "keywords": ["categoria", "articoli", "posts", "archivio", "blog", "card"],
    "textdomain": "cesana-assicuratori-blocks",
    "attributes": {
        "categorySlug": {
            "type": "string",
            "default": ""
        },
        "postsPerPage": {
            "type": "number",
            "default": 9
        },
        "columns": {
            "type": "number",
            "default": 3
        },
        "showExcerpt": {
            "type": "boolean",
            "default": true
        },
        "showAuthor": {
            "type": "boolean",
            "default": true
        },
        "showDate": {
            "type": "boolean",
            "default": true
        },
        "showReadingTime": {
            "type": "boolean",
            "default": true
        }
    },
    "supports": {
        "align": ["wide", "full"],
        "html": false
    },
    "editorScript": "file:./editor.js",
    "render": "file:./render.php"
}
