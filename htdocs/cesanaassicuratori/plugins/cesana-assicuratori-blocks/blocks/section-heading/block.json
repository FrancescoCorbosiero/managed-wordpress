{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "cesana/section-heading",
    "version": "1.0.0",
    "title": "Section Heading",
    "category": "cesana",
    "icon": "editor-textcolor",
    "description": "Blocco testo con eyebrow, titolo, descrizione e immagine opzionale. Allineamento configurabile.",
    "keywords": ["titolo", "heading", "eyebrow", "testo", "sezione"],
    "textdomain": "cesana-assicuratori-blocks",
    "attributes": {
        "eyebrow": {
            "type": "string",
            "default": ""
        },
        "title": {
            "type": "string",
            "default": ""
        },
        "description": {
            "type": "string",
            "default": ""
        },
        "textAlign": {
            "type": "string",
            "default": "left",
            "enum": ["left", "center", "right"]
        },
        "headingLevel": {
            "type": "number",
            "default": 2
        },
        "imageUrl": {
            "type": "string",
            "default": ""
        },
        "imageAlt": {
            "type": "string",
            "default": ""
        },
        "imagePosition": {
            "type": "string",
            "default": "right",
            "enum": ["left", "right", "top", "bottom"]
        }
    },
    "supports": {
        "align": ["wide", "full"],
        "html": false
    },
    "editorScript": "file:./editor.js",
    "render": "file:./render.php"
}
