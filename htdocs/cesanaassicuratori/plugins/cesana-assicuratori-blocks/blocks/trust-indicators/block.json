{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "cesana/trust-indicators",
    "version": "1.0.0",
    "title": "Trust Indicators",
    "category": "cesana",
    "icon": "shield",
    "description": "Striscia orizzontale con indicatori di fiducia: anni di esperienza, soddisfazione, certificazioni.",
    "keywords": ["trust", "fiducia", "badge", "indicatori", "esperienza"],
    "textdomain": "cesana-assicuratori-blocks",
    "attributes": {
        "indicators": {
            "type": "array",
            "default": []
        },
        "variant": {
            "type": "string",
            "default": "default",
            "enum": ["default", "dark"]
        }
    },
    "supports": {
        "align": ["wide", "full"],
        "html": false
    },
    "editorScript": "file:./editor.js",
    "render": "file:./render.php"
}
