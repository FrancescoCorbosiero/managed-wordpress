{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "cesana/hero-banner",
    "version": "1.0.0",
    "title": "Hero Banner",
    "category": "cesana",
    "icon": "slides",
    "description": "Banner hero full-screen con crossfade e CTA per homepage broker assicurativo.",
    "keywords": ["hero", "banner", "slider", "homepage"],
    "textdomain": "cesana-assicuratori-blocks",
    "attributes": {
        "slides": {
            "type": "array",
            "default": []
        },
        "autoplay": {
            "type": "number",
            "default": 8000
        },
        "showDots": {
            "type": "boolean",
            "default": true
        },
        "showArrows": {
            "type": "boolean",
            "default": true
        }
    },
    "supports": {
        "align": ["full"],
        "html": false
    },
    "editorScript": "file:./editor.js",
    "render": "file:./render.php"
}
